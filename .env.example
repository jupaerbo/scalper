# Copia este archivo a .env y rellena los valores. No subas .env al repositorio.

# Telegram (habla con @BotFather para crear el bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email
NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# En Gmail usa una "contraseña de aplicación", no tu contraseña normal.
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SSL=true  # para el puerto 465 (SSL directo) en lugar de STARTTLS

# Bot interactivo: limita quién puede usarlo (IDs separados por comas; vacío = todos)
TELEGRAM_ALLOWED_CHAT_IDS=

# Puerto del health check HTTP (Render lo define solo; por defecto 10000)
# PORT=10000

# Proxy para el buscador si la IP del servidor sufre rate-limit
# DDGS_PROXY=http://usuario:clave@host:puerto

# API de búsqueda de pago, solo si los buscadores gratuitos fallan (opcional)
# SEARCH_API_KEY=
# SEARCH_API_PROVIDER=serper   # serper (por defecto) | serpapi | google
# GOOGLE_CSE_ID=               # solo para SEARCH_API_PROVIDER=google

